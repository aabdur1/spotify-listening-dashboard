              <calculation class='tableau' formula='[Parameters].[Parameter 0084349226545153] = &quot;All&quot; OR STR(YEAR([month])) = [Parameters].[Parameter 0084349226545153]' />
            </column>
            <column datatype='string' name='[Genre (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[genre]' new-bin='true'>
                <bin default-name='false' value='&quot;everything else&quot;'>
                  <value>&quot;folk/acoustic&quot;</value>
                  <value>&quot;indie/rock&quot;</value>
                  <value>&quot;other&quot;</value>
                  <value>&quot;pop&quot;</value>
