              <bucket>&quot;bass music&quot;</bucket>
              <bucket>&quot;hip-hop/rap&quot;</bucket>
              <bucket>&quot;house/dance&quot;</bucket>
              <bucket>&quot;electronic&quot;</bucket>
              <bucket>&quot;classical/score&quot;</bucket>
              <bucket>&quot;everything else&quot;</bucket>
