            <column-instance column='[Calculation_0084349226934274]' derivation='None' name='[none:Calculation_0084349226934274:nk]' pivot='key' type='nominal' />
            <column-instance column='[hours]' derivation='Sum' name='[pcto:sum:hours:qk:3]' pivot='key' type='quantitative'>
