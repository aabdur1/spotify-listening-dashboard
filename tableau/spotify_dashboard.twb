          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Year Select' datatype='string' name='[Parameter 0084349226545153]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18d6cca0rqzzi91d7fqq2099i2xa'>
            <column caption='Skip Rate' datatype='real' default-format='p0.0%' name='[Calculation_0084349121093632]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - SUM([listens]) / SUM([streams_n])' />
            </column>
            <column caption='In Year' datatype='boolean' name='[Calculation_0084349382778885]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 0084349226545153] = &quot;All&quot; OR STR([year]) = [Parameters].[Parameter 0084349226545153]' />
            </column>
            <column caption='Dow' datatype='string' name='[dow]' role='dimension' type='nominal' />
            <column caption='Hour' datatype='integer' name='[hour]' role='measure' type='quantitative' />
            <column caption='Hours' datatype='real' name='[hours]' role='measure' type='quantitative' />
            <column caption='Listens' datatype='integer' name='[listens]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0084349382778885]' derivation='None' name='[none:Calculation_0084349382778885:nk]' pivot='key' type='nominal' />
            <column-instance column='[dow]' derivation='None' name='[none:dow:nk]' pivot='key' type='nominal' />
            <column-instance column='[hour]' derivation='None' name='[none:hour:ok]' pivot='key' type='ordinal' />
            <column caption='Streams N' datatype='integer' name='[streams_n]' role='measure' type='quantitative' />
            <column-instance column='[hours]' derivation='Sum' name='[sum:hours:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0084349121093632]' derivation='User' name='[usr:Calculation_0084349121093632:qk]' pivot='key' type='quantitative' />
            <column datatype='integer' name='[year]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.18d6cca0rqzzi91d7fqq2099i2xa].[none:Calculation_0084349382778885:nk]'>
            <groupfilter function='member' level='[none:Calculation_0084349382778885:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
