            <column caption='Year Select' datatype='string' name='[Parameter 0084349226545153]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.04dxvfu18ai0p917bj1zk0jgjjno'>
            <column caption='In Year' datatype='boolean' name='[Calculation_0084349226934274]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 0084349226545153] = &quot;All&quot; OR STR(YEAR([month])) = [Parameters].[Parameter 0084349226545153]' />
            </column>
            <column datatype='string' name='[Genre (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[genre]' new-bin='true'>
                <bin default-name='false' value='&quot;everything else&quot;'>
                  <value>&quot;folk/acoustic&quot;</value>
                  <value>&quot;indie/rock&quot;</value>
                  <value>&quot;other&quot;</value>
                  <value>&quot;pop&quot;</value>
                  <value>&quot;r&amp;b/soul&quot;</value>
                </bin>
              </calculation>
            </column>
