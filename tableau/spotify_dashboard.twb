            <column caption='Hours' datatype='real' name='[hours]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0084349226934274]' derivation='None' name='[none:Calculation_0084349226934274:nk]' pivot='key' type='nominal' />
            <column-instance column='[hours]' derivation='Sum' name='[pcto:sum:hours:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.04dxvfu18ai0p917bj1zk0jgjjno].[Genre (group)]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.04dxvfu18ai0p917bj1zk0jgjjno].[Genre (group)]'>
            <groupfilter function='level-members' level='[Genre (group)]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
